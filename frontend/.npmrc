# A declared engine that only warns is documentation, not a constraint. This makes a
# wrong Node version fail the install, which is the point of declaring it.
engine-strict=true
# Refuse versions published less than 7 days ago on install/update (O-ASH-NPMRC-RELEASE-AGE-001):
# a compromised release is usually caught and pulled within days. npm before 11.10 ignores it,
# so package.json sets the npm engine floor to 11.10.0 and engine-strict refuses older npm.
min-release-age=7
