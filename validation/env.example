# TEMPLATE ONLY. This file IS COMMITTED — never put a real value in it.
#
# Copy it, then edit the copy:
#
#   cp validation/env.example validation/.env.local
#   chmod 600 validation/.env.local
#   $EDITOR validation/.env.local
#   set -a; source validation/.env.local; set +a
#   uv run python validation/probe_amc.py --from-env --discover-only
#
# `.env*` is gitignored in this directory, as are filenames containing credentials,
# secret or token. This file is committed only because it holds no values. Confirm the
# copy is ignored before you paste anything into it:
#
#   git check-ignore -v validation/.env.local
#
# A local file is a development convenience, not the intended home for these values.
# Secrets Manager is, per validation/README.md — a file on a laptop outlives your
# intentions and gets copied places you did not choose. Fine for a probe; not for
# anything durable.

# QUOTE EVERY VALUE. A refresh token begins `Atzr|` and an unquoted pipe makes the
# shell try to run the rest of the line as a command. Found the hard way.

AMC_CLIENT_ID="amzn1.application-oa2-client.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# pragma: allowlist nextline secret (A-SECRET-PLACEHOLDER-001)
AMC_CLIENT_SECRET="amzn1.oa2-cs.v1.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
AMC_REFRESH_TOKEN="Atzr|xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# na | eu | fe — follows the advertiser's marketplace, NOT an AWS region.
# invalid_client means the id or secret is wrong; invalid_grant means the refresh token
# is wrong or revoked, OR this is.
AMC_REGION="na"

# All three are discovered by `--discover-only`. Leave empty on a first run.
AMC_ACCOUNT_ID=""
AMC_MARKETPLACE_ID=""
AMC_INSTANCE_ID=""

# --- Conversation route, for probe_conversation_route.py ---
#
# The harness declares a customJWTAuthorizer, so SigV4 is refused and every path to the
# agent needs a live user's access token. The app client permits refresh-token auth and
# nothing else, so there is no credential a test can obtain on its own. One browser login
# pasted here is the whole mechanism — see gap G-41 for why a second app client was
# rejected rather than deferred.
#
# Take both from a logged-in browser: DevTools, Application, Cookies, the CloudFront
# origin. Store the REFRESH cookie, not the session cookie — adl_session expires in
# fifteen minutes, adl_refresh in thirty days, and the probe exchanges one for the other
# through our own /api/auth/refresh route on each run.
#
# adl_refresh is a JWE: five dot-separated segments, no pipe. Quote it anyway.
ADL_REFRESH="xxxx.xxxx.xxxx.xxxx.xxxx"

# adl_csrf, the double-submit value. /api/auth/refresh sits outside the session
# authorizer by necessity — the access token has expired by definition when it is
# called — so this is what defends it, and the probe cannot refresh without it.
ADL_CSRF="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# The email address of the operator whose ADL_REFRESH this is. probe_prompt_registry.py
# asserts the version it creates is attributed to it, and prints only whether it matched.
ADL_EXPECTED_AUTHOR_EMAIL="operator@example.com"


# --- Authenticated browser acceptance, for probe_frontend_browser.mjs ---
#
# The deployed origin under test — the CloudFront distribution URL for the target
# environment. Kept here rather than committed in the probe so the script carries no
# live identifier and can point at any deployment.
ADL_BASE_URL="https://xxxxxxxxxxxxx.cloudfront.net"
