# Copy to .env and fill in. `make deploy-all` and `make destroy-all` read .env when it exists;
# it is gitignored. Fill in the blank values; the others are the values the development
# deployment runs, and you can change them. The authority for each one is infra/lib/config/index.ts; synth lists every value still missing.

# Cognito managed-login domain prefix. Globally unique across all AWS accounts, lowercase,
# letters, digits and hyphens. Users see it during sign-in.
ADLYTICS_LOGIN_DOMAIN_PREFIX=

# Amazon Bedrock model IDs or inference profile IDs. Enable access to all three (these two and
# ADLYTICS_MEMORY_MODEL_ID below) in the Bedrock console first. The pair below is what the
# development deployment runs (us-east-1; other Regions need their own profile IDs).
ADLYTICS_QUICK_CHAT_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
ADLYTICS_DEEP_DIVE_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Long-term memory override model (ADR-147). No fallback to the chat models.
# The ID has no date suffix by AWS's naming, not by omission: a SYSTEM_DEFINED profile, ACTIVE in
# us-east-1 and routing to anthropic.claude-sonnet-4-6 (get-inference-profile, 2026-10-18).
ADLYTICS_MEMORY_MODEL_ID=us.anthropic.claude-sonnet-4-6
# Optional: different models for page insight narration (default: the two above).
# ADLYTICS_INSIGHT_QUICK_MODEL_ID=
# ADLYTICS_INSIGHT_DEEP_MODEL_ID=

# Days each conversation turn's audit record is kept. Whole days, no default.
ADLYTICS_RECEIPT_RETENTION_DAYS=90

# General Athena query-batch admission: whole number from 1 to the CHAT reserve (20), no default.
# Leave at 8 unless you have measured another value (docs/capabilities/query-path/architecture.md).
ADLYTICS_ATHENA_QUERY_BATCH_MAX_CONCURRENCY=8
# AWS WAF rate limits, requests per source IP per five minutes, for the website and for sign-in.
ADLYTICS_EDGE_WAF_RATE_LIMIT_PER_FIVE_MINUTES=2000
ADLYTICS_USER_POOL_WAF_RATE_LIMIT_PER_FIVE_MINUTES=300

# Optional features, all off by default. See the README's "Optional features" section first.
# ADLYTICS_TRANSACTION_SEARCH=true
# ADLYTICS_EVALUATION_INPUT_PROVISIONED=true
# ADLYTICS_PRODUCER_ONBOARDING_ENABLED=true
# ADLYTICS_LANDING_PIPELINE_ROLE_ARN=
# ADLYTICS_LANDING_EXTERNAL_ID=
# The staffed alarm destination's topic, only where the environment selects the topic arm
# (contracts/operations/alarm-destinations.yaml); the email arm takes no value.
# ADLYTICS_STAFFED_ALARM_TOPIC_ARN=
